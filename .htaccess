RewriteEngine On
DirectoryIndex index.php

# PHP is the production web entry point. These redirects keep old HTML bookmarks working.
RewriteRule ^index\.html$ /login [R=302,L]
RewriteRule ^(login|dashboard|forms|forms-generator|reports|members|supervisors|settings)\.html$ /$1 [R=302,L]
RewriteRule ^(login|dashboard|forms|forms-generator|reports|members|supervisors|settings)/?$ index.php [QSA,L]
RewriteRule ^legacy-forms/?$ /forms [R=301,L]
RewriteRule ^api/(.*)$ index.php [QSA,L]

<FilesMatch "^(config|auth|api|page)\.php$">
  Require all denied
</FilesMatch>

<FilesMatch "\.(css|js|png|jpg|jpeg|gif|svg|webp|woff2?)$">
  Header set Cache-Control "public, max-age=86400"
</FilesMatch>
